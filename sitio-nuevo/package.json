    "verificar-fichas": "node scripts/verificar-fichas.js"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.6",
    "@11ty/eleventy-img": "7.0.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "pagefind": "1.5.2",
    "puppeteer-core": "25.12.0"
  }
}
