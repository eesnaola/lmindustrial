<!doctype html>
<html lang="es-AR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ titulo }}</title>
  <meta name="description" content="{{ descripcion }}">
  <link rel="canonical" href="{{ sitio.url }}{{ canonica or page.url }}">
  {# Vista previa al compartir (WhatsApp, redes). Las fichas reemplazan la imagen por la foto del producto. #}
  <meta property="og:site_name" content="{{ sitio.nombre }}">
  <meta property="og:locale" content="es_AR">
  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ titulo }}">
  <meta property="og:description" content="{{ descripcion }}">
  <meta property="og:url" content="{{ sitio.url }}{{ canonica or page.url }}">
  {% block imagenCompartir %}
  <meta property="og:image" content="{{ sitio.url }}/assets/img/compartir.jpg">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="LM Industrial: válvulas e insumos industriales">
  <meta name="twitter:card" content="summary_large_image">
  {% endblock %}
  {% if sitio.entorno == "prueba" or noindexar %}<meta name="robots" content="noindex, nofollow">{% endif %}
  <link rel="preload" href="/assets/fuentes/plex-400.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/css/estilos.css">
  <link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/assets/img/favicon-32.png" sizes="32x32" type="image/png">
  <link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png">
  <meta name="theme-color" content="#135a56">
  {% if sitio.entorno == "produccion" %}
  {# El script de Analytics (≈190 KB) se pide recién con la página cargada, para no competir en el celular con la
     foto y el texto principales; lo que se registre antes queda en dataLayer y se envía igual. #}
  <script>window.dataLayer = window.dataLayer || []; function gtag() { dataLayer.push(arguments); } gtag("js", new Date()); gtag("config", "{{ sitio.ga4 }}");
  window.addEventListener("load", function () { var s = document.createElement("script"); s.async = true; s.src = "https://www.googletagmanager.com/gtag/js?id={{ sitio.ga4 }}"; document.head.appendChild(s); });</script>
  {% endif %}
  {% block head %}{% endblock %}
</head>
<body>
  <a class="saltar" href="#contenido">Saltar al contenido</a>
  {% include "parciales/encabezado.njk" %}
  <main id="contenido"{% if indexar %} data-pagefind-body{% endif %}>
    {% block contenido %}{% endblock %}
  </main>
  {% include "parciales/pie.njk" %}
</body>
</html>
